# Sao chép thành config.env rồi sửa. Mọi script đọc file này.
AISWATCH_DATA=/srv/aiswatch          # nơi chứa dữ liệu + kết quả (cần ~40 GB trống khi chạy dài, ~1 GB/ngày tạm thời)
AISWATCH_MODE=live                   # live: dữ liệu mới; demo: hiện thêm "đáp án" khi phát lại quá khứ
START_DATE=2025-10-01                # ngày X: xử lý dữ liệu từ ngày này tới hôm qua (UTC)
SCORE_FROM=                          # (tuỳ chọn) chỉ chấm/hiển thị từ ngày này; để trống = START_DATE + 29 ngày
SPARK_CORES=4
SPARK_MEM=4g
KEEP_SILVER_DAYS=1
WATCH_K=30
PORT_VIZ=8501                        # trang giám sát
PORT_APP=8502                        # trang kết quả mô hình
BIND=127.0.0.1                       # 0.0.0.0 nếu muốn mở ra ngoài (nên đặt sau reverse proxy có xác thực)
# HTTPS_PROXY=http://user:pass@host:port   # nếu server cần proxy để ra internet
